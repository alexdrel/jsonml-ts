{
  "name": "@alexdrel/jsonml-ts",
  "version": "0.5.1",
  "description": "JsonML for TypeScript: create, traverse, edit, and serialize XML, HTML, and SVG as ordinary arrays.",
  "keywords": [
    "jsonml",
    "json",
    "xml",
    "html",
    "svg",
    "typescript",
    "markup",
    "serialization",
    "tree-traversal"
  ],
  "homepage": "https://github.com/alexdrel/jsonml-ts#readme",
  "bugs": {
    "url": "https://github.com/alexdrel/jsonml-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexdrel/jsonml-ts.git"
  },
  "license": "MIT",
  "author": "Alex Drel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/jsonml.d.ts",
      "import": "./dist/src/jsonml.js"
    },
    "./serialize": {
      "types": "./dist/src/serialize.d.ts",
      "import": "./dist/src/serialize.js"
    },
    "./html": {
      "types": "./dist/src/html.d.ts",
      "import": "./dist/src/html.js"
    },
    "./assert": {
      "types": "./dist/src/assert.d.ts",
      "import": "./dist/src/assert.js"
    },
    "./types/svg": {
      "types": "./dist/types/svg.d.ts",
      "import": "./dist/types/svg.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "test:unit": "node --test src/test/*.test.ts types/*.test.ts examples/*/*.test.ts",
    "test": "npm run fmt:check && npm run lint && npm run check && npm run test:unit",
    "example:svg": "node examples/svg/progress.ts",
    "example:roundtrip": "node examples/logo/roundtrip.ts",
    "example:logo": "node examples/logo/create.ts",
    "example:export": "node examples/board/export.ts examples/board/draft.svg > examples/board/output/exported.svg",
    "example:text": "node examples/text/replace.ts examples/text/source.xml Topos \"Topos Studio\" > examples/text/output/replaced.xml",
    "example:vocab": "node examples/catalog/catalog.ts",
    "prepack": "npm run build",
    "lint": "oxlint --deny-warnings src types examples",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@xmldom/xmldom": "^0.9.12",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
