{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "lib": ["ES2024", "ESNext.Iterator"]
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "examples/**/*.ts"]
}
